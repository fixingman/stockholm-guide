<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark"><meta name="supported-color-schemes" content="light dark">
<title>The Stockholm Guide — {{ guide.date_range }}</title>
<style>
/* Progressive enhancement; non-supporting email clients retain inline light colors. */
@media (prefers-color-scheme: dark) {
 body{background:#181818!important;color:#f3f0ec!important}
 .shell{background:#242424!important;border-color:#454545!important}
 .brand,.descriptor,.edition,.event-name,.event-card-link{color:#f7f4ef!important}
 .event-meta,.event-description{color:#e0dbd4!important}
 .event-content a,.event-card-link span{color:#eae6df!important}
 .unavailable-meta{color:#d0cbc4!important}
 .feedback-link{background:#242424!important;color:#f7f4ef!important;border-color:#aaa299!important}
 .section-heading{color:#fcfaf6!important}
}
@media screen and (max-width:600px){
 .outer{padding:0!important}.shell{width:100%!important;max-width:100%!important;border-radius:0!important}
 .inset{padding-left:19px!important;padding-right:19px!important}
 .brand{font-size:36px!important;line-height:35px!important;letter-spacing:-1.6px!important}
 .descriptor{font-size:8px!important;line-height:13px!important;letter-spacing:.2px!important}
 .brand-cell{width:63%!important}.descriptor-cell{width:37%!important}
 .top-thumb-cell{width:88px!important;padding-right:12px!important}.top-thumb{width:76px!important;height:76px!important}.event-content{padding-left:13px!important}
 .event-name{font-size:17px!important;line-height:23px!important}
 .event-description{font-size:13px!important;line-height:19px!important}
 .section-heading{font-size:15px!important;line-height:21px!important;letter-spacing:.6px!important}
 .edition{font-size:11px!important;line-height:16px!important}
 .section-pad{padding-top:36px!important}.row-pad{padding-top:14px!important;padding-bottom:14px!important}
}
@media screen and (max-width:360px){
 .brand{font-size:30px!important;line-height:30px!important}
 .descriptor{font-size:7px!important;line-height:12px!important}
 .inset{padding-left:15px!important;padding-right:15px!important}
 .top-thumb-cell{width:68px!important;padding-right:8px!important}.top-thumb{width:60px!important;height:60px!important}
 .event-content{padding-left:10px!important}
}
</style>
</head>
<body style="margin:0;padding:0;background:#f2f0eb;color:#121212;-webkit-text-size-adjust:100%;">
<div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;">{{ guide.inbox_preheader }}</div>
{% macro section_header(name) -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;width:100%;background:#161616;">
<tr><td style="width:14px;vertical-align:middle;padding:13px 0 13px 14px;"><span style="display:block;width:8px;height:8px;border-radius:50%;background:#fcfaf6;font-size:0;line-height:0;">&nbsp;</span></td><td style="vertical-align:middle;padding:11px 15px 11px 13px;"><h2 class="section-heading" style="margin:0;font:bold 17px/24px 'Courier New',Courier,monospace;letter-spacing:1px;text-transform:uppercase;color:#fcfaf6;">{{ name }}</h2></td></tr>
</table>
{%- endmacro %}
{% macro event_body(item, condensed=false) -%}
<a class="event-card-link" href="{{ item.url }}" style="display:block;text-decoration:none;color:#121212;">
{% if item.get('scan_cues') %}<span class="scan-cues" style="display:block;padding-bottom:7px;font:10px/16px 'Courier New',Courier,monospace;letter-spacing:.55px;color:#675a4b;">{% for cue in item.scan_cues %}<span style="display:inline-block;border:1px solid #b4a99e;border-radius:2px;padding:1px 5px;margin-right:5px;margin-bottom:3px;">{{ cue }}</span>{% endfor %}</span>{% endif %}
<span class="event-name" style="display:block;font:bold {{ '17px/23px' if condensed else '19px/25px' }} Arial,Helvetica,sans-serif;letter-spacing:-.45px;color:#121212;">{{ item.display_title|default(item.title) }}</span>
<span class="event-meta" style="display:block;font:12px/18px 'Courier New',Courier,monospace;color:#444;padding-top:6px;">{{ item.dates }}{% if item.get('venue') %} · {{ item.venue }}{% endif %}</span>
{% if item.get('description') %}<span class="event-description" style="display:block;font:14px/21px Arial,Helvetica,sans-serif;padding-top:7px;color:#262626;">{{ item.description }}</span>{% endif %}
<span style="display:block;font:12px/18px Arial,Helvetica,sans-serif;color:#655f58;padding-top:8px;">{{ item.price }} · Booking: {{ item.booking }}</span>
</a>
{%- endmacro %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
<tr><td class="outer" align="center" style="padding:20px 12px 40px;">
<table role="presentation" class="shell" width="650" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:650px;border-collapse:separate;border-spacing:0;background:#fcfaf6;border-radius:15px;overflow:hidden;border:1px solid #e4dfd7;box-shadow:0 4px 16px #0000000b;">
<tr><td class="inset" style="padding:38px 35px 0;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;border-collapse:collapse;"><tr>
<td class="brand-cell" width="60%" valign="top" style="width:60%;vertical-align:top;padding:0;"><h1 class="brand" style="margin:0;font:bold 48px/46px Georgia,'Times New Roman',serif;letter-spacing:-2.2px;color:#101010;">The<br>Stockholm<br>Guide</h1></td>
<td class="descriptor-cell" width="40%" valign="top" style="width:40%;vertical-align:top;padding:9px 0 0 12px;box-sizing:border-box;"><div class="descriptor" style="font:bold 10px/17px 'Courier New',Courier,monospace;letter-spacing:.7px;">A CURATED GUIDE TO<br>CULTURE, ART AND<br>IDEAS IN STOCKHOLM</div></td>
</tr></table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;border-top:1px solid #777;border-bottom:1px solid #777;margin-top:28px;"><tr>
<td width="30%" style="padding:14px 5px 14px 0;vertical-align:middle;"><div class="edition" style="font:bold 12px/18px 'Courier New',Courier,monospace;">The Weekly</div></td>
<td width="45%" align="center" style="padding:14px 5px;vertical-align:middle;"><div class="edition" style="font:12px/18px 'Courier New',Courier,monospace;">{{ guide.date_range }}</div></td>
<td width="25%" align="right" style="padding:14px 0 14px 5px;vertical-align:middle;"><div class="edition" style="font:12px/18px 'Courier New',Courier,monospace;">#{{ guide.issue_number }}</div></td>
</tr></table>
</td></tr>
<tr><td class="inset section-pad" style="padding:33px 35px 0;">
{{ section_header('Top 3 picks') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;width:100%;">
{% for item in guide.top3 %}
<tr><td class="top-thumb-cell row-pad" width="112" valign="top" style="width:112px;vertical-align:top;padding:20px 12px 20px 0;border-bottom:1px solid #d7d2cb;box-sizing:border-box;">
<a class="top-thumb-link" href="{{ item.url }}" aria-label="View event: {{ item.display_title|default(item.title) }}" style="display:block;text-decoration:none;">
{% if item.get('image_verified') == true and item.get('image_url') %}
{% if item.get('image_cache_file') %}{% set photo = asset_base_url ~ '/' ~ item.image_cache_file %}{% else %}{% set photo = item.image_url %}{% endif %}
<img class="top-thumb" src="{{ photo }}" alt="{{ item.image_alt }}" width="96" height="96" style="display:block;width:96px;height:96px;object-fit:cover;border:0;border-radius:7px;background:#dedad2;">
{% else %}
<span class="top-thumb" role="img" aria-label="No verified event photo available" style="display:block;width:96px;height:96px;background:#e3dfd8;border-radius:7px;text-align:center;box-sizing:border-box;padding-top:27px;">
<span style="display:block;font:bold 24px/28px Georgia,'Times New Roman',serif;color:#7e776e;letter-spacing:-1px;">SG</span>
<span style="display:block;font:8px/12px 'Courier New',Courier,monospace;color:#6c665e;letter-spacing:.3px;">EVENT GUIDE</span>
</span>
{% endif %}
</a>
</td>
<td class="event-content row-pad" valign="top" style="vertical-align:top;padding:20px 0 20px 18px;border-bottom:1px solid #d7d2cb;">{{ event_body(item) }}</td></tr>
{% endfor %}</table>
</td></tr>
<tr><td class="inset section-pad" style="padding:43px 35px 0;">
{{ section_header('New discoveries') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;width:100%;">
{% for item in guide.new_discoveries %}
<tr><td class="row-pad" style="padding:17px 0;border-bottom:1px solid #d7d2cb;">{{ event_body(item,true) }}</td></tr>
{% endfor %}
</table></td></tr>
<tr><td class="inset section-pad" style="padding:43px 35px 0;">
{{ section_header('Worth reconsidering') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;width:100%;">
{% for item in guide.worth_reconsidering %}
<tr><td class="row-pad" style="padding:17px 0;border-bottom:1px solid #d7d2cb;">{{ event_body(item,true) }}</td></tr>
{% endfor %}
</table></td></tr>
<tr><td class="inset section-pad" style="padding:43px 35px 0;">
{{ section_header('Unavailable / sold out') }}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;width:100%;">
{% for item in guide.unavailable %}
<tr><td class="row-pad unavailable-row" style="padding:13px 0;border-bottom:1px solid #d7d2cb;">
<a class="event-name" href="{{ item.url }}" style="font:bold 17px/23px Arial,Helvetica,sans-serif;letter-spacing:-.45px;text-decoration:none;color:#121212;">{{ item.title }}</a>
<div class="unavailable-meta" style="font:12px/19px 'Courier New',Courier,monospace;color:#555;padding-top:5px;">{{ item.dates }} · {{ item.booking }}</div>
</td></tr>
{% endfor %}
</table>
<p style="font:12px/19px Arial,Helvetica,sans-serif;color:#716b64;margin:22px 0 24px;">{{ guide.disclaimer }}</p>
</td></tr>
<tr><td class="inset" style="padding:24px 35px 19px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;border-top:1px solid #b9b5ae;">
<tr><td style="padding:18px 0 11px;"><div style="font:bold 11px/17px 'Courier New',Courier,monospace;letter-spacing:.8px;color:#302e2a;text-transform:uppercase;">Was this issue useful?</div></td></tr>
<tr><td>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;table-layout:fixed;border-collapse:separate;border-spacing:0;">
<tr>
<td width="32%" style="width:32%;padding-right:7px;"><a class="feedback-link" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=cankilicbay%40gmail.com&amp;su={{ ('Stockholm Guide #' ~ guide.issue_number ~ ' | LIKE')|urlencode }}&amp;body={{ ('I liked Stockholm Guide issue #' ~ guide.issue_number ~ '. Optional feedback: ')|urlencode }}" style="display:block;text-align:center;background:#fcfaf6;color:#171717;border:1px solid #99928b;border-radius:4px;font:bold 12px/18px Arial,Helvetica,sans-serif;text-decoration:none;padding:9px 2px;">&#128077; Like</a></td>
<td width="32%" style="width:32%;padding-left:3px;padding-right:4px;"><a class="feedback-link" href="https://mail.google.com/mail/?view=cm&amp;fs=1&amp;to=cankilicbay%40gmail.com&amp;su={{ ('Stockholm Guide #' ~ guide.issue_number ~ ' | DISLIKE')|urlencode }}&amp;body={{ ('I disliked Stockholm Guide issue #' ~ guide.issue_number ~ '. Optional feedback: ')|urlencode }}" style="display:block;text-align:center;background:#fcfaf6;color:#171717;border:1px solid #99928b;border-radius:4px;font:bold 12px/18px Arial,Helvetica,sans-serif;text-decoration:none;padding:9px 2px;">&#128078; Dislike</a></td>
<td width="36%" style="width:36%;padding-left:6px;"><a class="feedback-link" href="mailto:cankilicbay@gmail.com?subject={{ 'Stockholm Guide | UNSUBSCRIBE'|urlencode }}&amp;body={{ 'Please remove my email address from future Stockholm Guide editions.\n\nThank you.'|urlencode }}" style="display:block;text-align:center;background:#fcfaf6;color:#171717;border:1px solid #99928b;border-radius:4px;font:bold 12px/18px Arial,Helvetica,sans-serif;text-decoration:none;padding:9px 2px;">Unsubscribe</a></td>
</tr></table></td></tr>
<tr><td style="padding:10px 0 0;"><div style="font:11px/17px Arial,Helvetica,sans-serif;color:#716b64;">Like and Dislike open a prefilled Gmail draft; press Send to submit your feedback. Unsubscribe opens an email draft and is handled manually. No tracking service is used.</div></td></tr>
</table></td></tr>
<tr><td><img src="{{ asset_base_url }}/milestone_skyline.png" alt="Original black-and-white Stockholm skyline from the approved milestone" width="650" style="display:block;width:100%;height:auto;border:0;" /></td></tr>
</table></td></tr></table>
</body></html>
